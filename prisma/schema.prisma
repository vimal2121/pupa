generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  altText      String?
  caption      String?
  title        String?
  description  String?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  projects         Project[]        @relation("ProjectMediaAssets")
  projectThumbnail Project[]        @relation("ProjectThumbnail")
  projectHero      Project[]        @relation("ProjectHero")
  projectOg        Project[]        @relation("ProjectOg")
  
  blogFeatured     BlogPost[]       @relation("BlogFeatured")
  blogOg           BlogPost[]       @relation("BlogOg")
}

model Project {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  client          String?
  categoryId      String?
  category        ProjectCategory? @relation(fields: [categoryId], references: [id])
  year            String?
  description     String?
  challenge       String?
  strategy        String?
  story           String?
  youtubeUrl      String?
  
  // Media Relations
  thumbnailId     String?
  thumbnail       MediaAsset?      @relation("ProjectThumbnail", fields: [thumbnailId], references: [id])
  heroImageId     String?
  heroImage       MediaAsset?      @relation("ProjectHero", fields: [heroImageId], references: [id])
  ogImageId       String?
  ogImage         MediaAsset?      @relation("ProjectOg", fields: [ogImageId], references: [id])
  gallery         MediaAsset[]     @relation("ProjectMediaAssets")
  
  featured        Boolean          @default(false)
  published       Boolean          @default(false)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  credits         ProjectCredit[]
}

model ProjectCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  projects Project[]
}

model ProjectCredit {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String
  name      String
  order     Int     @default(0)
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String?
  content        String
  
  // Media Relations
  featuredImageId String?
  featuredImage   MediaAsset?  @relation("BlogFeatured", fields: [featuredImageId], references: [id])
  ogImageId       String?
  ogImage         MediaAsset?  @relation("BlogOg", fields: [ogImageId], references: [id])
  
  author         String?
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  status         String        @default("DRAFT") // DRAFT, PUBLISHED
  publishDate    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tags           BlogTag[]     @relation("BlogPostToBlogTag")
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[] @relation("BlogPostToBlogTag")
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  message   String
  status    String   @default("NEW") // NEW, CONTACTED, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
